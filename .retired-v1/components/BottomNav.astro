---
// Mobile bottom dock — app-style page navigation for small screens.
// Mirrors the desktop rail's vocabulary (cream surface, terracotta bar
// indicator, stroke icons) as a floating dock. Active state is rendered
// server-side for first paint and re-synced by the runtime on every
// astro:page-load (the dock persists across View Transitions).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const items = [
  { href: '/', label: 'Home' },
  { href: '/web-design', label: 'Websites' },
  { href: '/design', label: 'Design' },
  { href: '/photography', label: 'Photo' },
  { href: '/marketing', label: 'Marketing' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<nav class="bnav" id="bnav" aria-label="Site pages" transition:persist="bnav">
  {items.map((item) => (
    <a href={item.href} class:list={["bnav-item", { current: isCurrent(item.href) }]} data-page={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
      <span class="bnav-item-bar" aria-hidden="true"></span>
      <span class="bnav-item-icon" aria-hidden="true">
        {item.href === '/' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4.5 10.4 12 4.2l7.5 6.2"/><path d="M6.4 8.9v9.7a1.3 1.3 0 0 0 1.3 1.3h8.6a1.3 1.3 0 0 0 1.3-1.3V8.9"/></svg>
        )}
        {item.href === '/web-design' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3.5l8.5 4.2-8.5 4.2-8.5-4.2L12 3.5z"/><path d="M3.5 12l8.5 4.2 8.5-4.2"/><path d="M3.5 16.3l8.5 4.2 8.5-4.2"/></svg>
        )}
        {item.href === '/design' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M15.6 4.4 19.6 8.4M3.5 20.5l1.4-4.7L15 5.7a1.8 1.8 0 0 1 2.5 0l1 1a1.8 1.8 0 0 1 0 2.5L8.2 19.1z"/><path d="M4.9 15.8 8.2 19.1"/></svg>
        )}
        {item.href === '/photography' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5a1.6 1.6 0 0 1 1.6-1.6h1.7l1.1-1.8h6.2l1.1 1.8h1.7a1.6 1.6 0 0 1 1.6 1.6v8a1.6 1.6 0 0 1-1.6 1.6H5.1a1.6 1.6 0 0 1-1.6-1.6z"/><circle cx="12" cy="12.2" r="3.1"/></svg>
        )}
        {item.href === '/marketing' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 9.5v5a1 1 0 0 0 1 1h2l8 4.5V4L7 8.5H5a1 1 0 0 0-1 1z"/><path d="M18.5 9a4 4 0 0 1 0 6"/></svg>
        )}
      </span>
      <span class="bnav-item-name">{item.label}</span>
    </a>
  ))}
</nav>
