---
// All client behaviour, written to survive Astro View Transitions:
//  - GSAP + ScrollTrigger + Lenis loaded once (CDN, is:inline).
//  - Lenis + rail wiring created once; the rail persists across navigations.
//  - Per-page animations rebuilt on every astro:page-load (kill + recreate).
//  - The mesh shader is disposed on astro:before-swap so WebGL contexts
//    never leak between shader pages.
---
<!-- GSAP + Lenis (load once, ahead of the module) -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline src="https://unpkg.com/lenis@1/dist/lenis.min.js"></script>

<script>
  import { ShaderMount, meshGradientFragmentShader } from '@paper-design/shaders';

  /* ===== persistent singletons (survive navigations) ===== */
  let lenis = null;
  let shader = null;
  let wired = false;
  let booted = false;
  let pageCtrl = null;   // aborts per-page window/document listeners on swap
let closeLightbox = null;   // teardown for an open lightbox, run on swap
let pageObservers = [];     // per-page IntersectionObservers, disconnected on swap
let panFrames = [];         // live pan rAF ids, cancelled on swap
  let gsapTries = 0;     // failsafe counter: fall back to static if CDNs never load

  const path = () => (location.pathname.replace(/\/+$/, '') || '/');
  const isHome = () => path() === '/';
  const isMobile = () => window.matchMedia('(max-width: 820px)').matches;

  function ensureLenis() {
    if (lenis || typeof Lenis === 'undefined') return lenis;
    lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
    window.__lenis = lenis;
    lenis.on('scroll', () => { if (window.ScrollTrigger) window.ScrollTrigger.update(); });
    const raf = (t) => { lenis.raf(t); requestAnimationFrame(raf); };
    requestAnimationFrame(raf);
    return lenis;
  }

  /* ===== rail (wired once; DOM persists across navigations) ===== */
  const SHOW = 100, HIDE = 60;

  function railIn(on) {
    document.body.classList.toggle('rail-in', on);
  }
  function bnavIn(on) {
    document.body.classList.toggle('bnav-in', on);
  }
  // Desktop shows the side rail, mobile the bottom dock; the other class is
  // always cleared so the rail's content squeeze can never fire on mobile.
  function navIn(on) {
    if (isMobile()) { bnavIn(on); railIn(false); }
    else { railIn(on); bnavIn(false); }
  }
  function checkScroll() {
    // Home page: the nav is scroll-governed on every viewport (slides in
    // once you leave the hero, slides away again back at the top).
    // Interior pages keep it in permanently.
    if (!isHome()) return;
    if (window.scrollY > SHOW) navIn(true);
    else if (window.scrollY < HIDE) {
      navIn(false);
      collapseRail();
    }
  }
  function applyRailState() {
    if (isHome()) navIn(window.scrollY > SHOW);
    else navIn(true);
    updateRailCurrent();
  }
  function updateRailCurrent() {
    const p = path();
    document.querySelectorAll('#rail .rail-item, #bnav .bnav-item').forEach((el) => {
      const href = el.getAttribute('data-page') || '';
      const on = href === '/' ? p === '/' : (p === href || p.startsWith(href + '/'));
      el.classList.toggle('current', on);
      if (on) el.setAttribute('aria-current', 'page'); else el.removeAttribute('aria-current');
    });
  }

  let collapseTimer;
  let scrollLocked = false;
  function collapseRail() {
    const rail = document.getElementById('rail');
    const burger = document.getElementById('rail-burger');
    const backdrop = document.getElementById('rail-backdrop');
    rail && rail.classList.remove('expanded');
    backdrop && backdrop.classList.remove('visible');
    if (burger) { burger.classList.remove('active'); burger.setAttribute('aria-expanded', 'false'); }
    if (scrollLocked) { document.body.style.overflow = ''; scrollLocked = false; }
  }

  function wireRail() {
    if (wired) return;
    const rail = document.getElementById('rail');
    const burger = document.getElementById('rail-burger');
    const logo = document.getElementById('rail-logo');
    const backdrop = document.getElementById('rail-backdrop');
    if (!rail || !burger || !logo || !backdrop) return;

    window.addEventListener('scroll', checkScroll, { passive: true });

    rail.addEventListener('mouseenter', () => {
      if (isMobile()) return;
      if (collapseTimer) { clearTimeout(collapseTimer); collapseTimer = undefined; }
      rail.classList.add('expanded');
    });
    rail.addEventListener('mouseleave', () => {
      if (isMobile()) return;
      collapseTimer = window.setTimeout(() => rail.classList.remove('expanded'), 120);
    });

    function expandMobile() {
      rail.classList.add('expanded');
      backdrop.classList.add('visible');
      burger.classList.add('active');
      burger.setAttribute('aria-expanded', 'true');
      if (!scrollLocked) { document.body.style.overflow = 'hidden'; scrollLocked = true; }
    }
    burger.addEventListener('click', () => {
      if (!isMobile()) return;
      rail.classList.contains('expanded') ? collapseRail() : expandMobile();
    });
    logo.addEventListener('click', (e) => {
      if (isMobile() && !rail.classList.contains('expanded')) { e.preventDefault(); expandMobile(); }
    });
    backdrop.addEventListener('click', collapseRail);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMobile() && rail.classList.contains('expanded')) collapseRail();
    });
    rail.querySelectorAll('.rail-item, .rail-cta').forEach((link) => {
      link.addEventListener('click', () => { if (isMobile()) collapseRail(); });
    });

    // Smooth-scroll for in-page hash links (delegated once; covers the
    // persistent rail CTA and any in-page anchors on the current page).
    document.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        if (window.__lenis) window.__lenis.scrollTo(target, { offset: -40 });
        else target.scrollIntoView({ behavior: 'smooth' });
      }
    });

    let lastMobile = isMobile();
    window.addEventListener('resize', () => {
      const now = isMobile();
      if (lastMobile !== now) { collapseRail(); lastMobile = now; applyRailState(); }
    });

    // Image lightbox: delegated once; case-study artwork + gallery images
    // open full-screen so menus and print work are actually readable.
    const LB_SCOPES = '.cs-plinth, .cs-campaign-row, .cs-split__media, .cs-collage__stage, .photo-gallery';
    document.addEventListener('click', (e) => {
      const img = e.target.closest && e.target.closest(LB_SCOPES.split(', ').map((s) => s + ' img').join(', '));
      if (!img) return;
      e.preventDefault();
      openLightbox(img);
    });
    document.querySelectorAll(LB_SCOPES).forEach((el) => el.classList.add('lb-zoom'));

    wired = true;
  }

  function openLightbox(img) {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-label', img.alt || 'Image preview');
    const big = document.createElement('img');
    big.src = img.currentSrc || img.src;
    big.alt = img.alt || '';
    const close = document.createElement('button');
    close.className = 'lightbox__close';
    close.setAttribute('aria-label', 'Close image preview');
    close.textContent = '×';
    overlay.append(big, close);
    // Held at module scope so astro:before-swap can close an open lightbox.
    // Without that, navigating (or pressing Back) with the overlay open
    // discards it without restarting Lenis, leaving the destination page
    // unscrollable with a stale keydown listener still on document.
    const teardown = () => {
      overlay.remove();
      document.removeEventListener('keydown', onKey);
      if (window.__lenis) window.__lenis.start();
      document.body.style.overflow = '';
      if (closeLightbox === teardown) closeLightbox = null;
    };
    const onKey = (e) => { if (e.key === 'Escape') teardown(); };
    overlay.addEventListener('click', teardown);
    document.addEventListener('keydown', onKey);
    if (window.__lenis) window.__lenis.stop();
    document.body.style.overflow = 'hidden';
    document.body.appendChild(overlay);
    close.focus();
    closeLightbox = teardown;
  }

  /* ===== mesh shader ===== */
  function mountShader() {
    const el = document.getElementById('hero-shader');
    if (!el || typeof ShaderMount === 'undefined') return;
    if (shader) return;
    // ShaderMount throws where WebGL is unavailable (older devices, blocked
    // GPU, headless). The gradient is decorative; page setup must survive it.
    try {
      shader = createShader(el);
    } catch (e) {
      shader = null;
    }
  }
  function createShader(el) {
    return new ShaderMount(el, meshGradientFragmentShader, {
      u_colors: [
        [0.980, 0.969, 0.957, 1],
        [0.941, 0.922, 0.898, 1],
        [0.831, 0.443, 0.306, 1],
        [0.831, 0.443, 0.306, 1],
        [0.980, 0.969, 0.957, 1],
      ],
      u_colorsCount: 5,
      u_distortion: 0.5,
      u_swirl: 0.1,
      u_grainMixer: 0,
      u_grainOverlay: 0,
      u_fit: 2,
      u_scale: 1,
    }, {}, 0.5);
  }
  function disposeShader() {
    if (shader) { try { shader.dispose(); } catch (e) {} shader = null; }
  }

  /* ===== helpers ===== */
  // Split a heading into per-character spans grouped into word wrappers.
  // Words are inline-block (never break internally) separated by REAL spaces
  // so the heading still wraps naturally — the old flat &nbsp; version made
  // long headings unwrappable, overflowing their columns. Child elements
  // (e.g. the .accent span) are preserved so their colour survives the split.
  function splitChars(el) {
    const chars = [];
    const split = (node) => {
      if (node.nodeType === 3) {
        const frag = document.createDocumentFragment();
        node.textContent.split(/(\s+)/).forEach((part) => {
          if (!part) return;
          // \s also matches U+00A0, so collapsing every whitespace run to a
          // plain space threw away non-breaking spaces and let headings break
          // where the copy deliberately binds words together.
          if (/^\s+$/.test(part)) {
            const nb = part.indexOf('\u00A0') !== -1;
            frag.appendChild(document.createTextNode(nb ? '\u00A0' : ' '));
            return;
          }
          const word = document.createElement('span');
          word.style.display = 'inline-block';
          for (const ch of part) {
            const s = document.createElement('span');
            s.textContent = ch;
            s.style.display = 'inline-block';
            s.style.opacity = '0';
            s.style.filter = 'blur(12px)';
            word.appendChild(s);
            chars.push(s);
          }
          frag.appendChild(word);
        });
        node.parentNode.replaceChild(frag, node);
      } else if (node.nodeType === 1) {
        Array.from(node.childNodes).forEach(split);
      }
    };
    Array.from(el.childNodes).forEach(split);
    return chars;
  }

  function killTriggers() {
    if (window.ScrollTrigger) window.ScrollTrigger.getAll().forEach((t) => t.kill());
  }

  /* ===== loader (first load only) ===== */
  function playLoaderThen(cb) {
    const loader = document.getElementById('loader');
    const loaderText = document.getElementById('loader-text');
    const loaderBar = document.getElementById('loader-bar');
    if (!loader || loader.style.display === 'none') { cb(); return; }
    let done = false;
    const finish = () => { if (done) return; done = true; cb(); };
    const tl = window.gsap.timeline({
      onComplete: () => {
        window.gsap.to(loader, {
          yPercent: -100, duration: 0.5, ease: 'power3.inOut',
          onComplete: () => { loader.style.display = 'none'; loader.setAttribute('aria-hidden', 'true'); finish(); },
        });
      },
    });
    tl.to(loaderText, { opacity: 1, duration: 0.4, ease: 'power2.out' })
      .to(loaderBar, { width: '100%', duration: 0.7, ease: 'power2.inOut' }, '-=0.15');
    // Failsafe: if the RAF-driven timeline ever stalls (backgrounded tab,
    // GSAP error), never trap the user behind the loader.
    setTimeout(() => {
      if (loader.style.display !== 'none') { loader.style.display = 'none'; loader.setAttribute('aria-hidden', 'true'); }
      finish();
    }, 3000);
  }

  /* ===== per-page animations ===== */
  function initAnimations() {
    const gsap = window.gsap, ScrollTrigger = window.ScrollTrigger;

    // Hero pin: only the full-viewport shader heroes (home, web-design) scroll
    // content over a pinned hero. Photo/dark/plain heroes flow normally.
    if (document.getElementById('hero-shader') && document.querySelector('.page-content')) {
      ScrollTrigger.create({ trigger: '#hero', start: 'top top', end: 'bottom top', pin: true, pinSpacing: false });
    }

    // Hero intro. On the home page a rapid-fire flash of the five disciplines
    // (once per session) resolves into the persistent headline; the headline
    // itself always plays the character blur-reveal.
    //
    // Gated on visibility: these tweens set their start state (opacity 0,
    // words below the mask) the moment they are created, and a background tab
    // throttles the ticker to a standstill, which could strand the hero
    // mid-reveal. If the tab is hidden we simply wait for it to be looked at.
    const wordInners = document.querySelectorAll('.hero-word-inner');
    if (wordInners.length) {
      const runHeroIntro = () => {
      const heroTl = gsap.timeline();
      const flash = document.getElementById('hero-flash');
      let flashSeen = false;
      try { flashSeen = !!sessionStorage.getItem('kombu-flash'); } catch (e) {}
      if (flash && !flashSeen) {
        try { sessionStorage.setItem('kombu-flash', '1'); } catch (e) {}
        // Masked vertical roll: each word sweeps up into view with a slight
        // skew, holds a beat, then rolls out as the next enters; the final
        // word blooms away into the headline reveal.
        const fw = flash.querySelectorAll('.hero-flash__word');
        const bar = flash.querySelector('.hero-flash__bar');
        const flashTl = gsap.timeline();
        if (bar) flashTl.to(bar, { scaleX: 1, duration: 0.35, ease: 'power3.out' }, 0);
        // Beats trimmed a touch so the headline lands sooner: the roll still
        // reads at speed, it just stops holding the page hostage.
        const IN = 0.22, HOLD = 0.13, OUT = 0.18, OVERLAP = 0.1;
        let t = 0.06;
        fw.forEach((w, i) => {
          flashTl.fromTo(w,
            { yPercent: 118, skewY: 5, autoAlpha: 1, transformOrigin: '50% 50%' },
            { yPercent: 0, skewY: 0, duration: IN, ease: 'power4.out' }, t);
          const outAt = t + IN + HOLD;
          if (i < fw.length - 1) {
            flashTl.to(w, { yPercent: -118, skewY: -5, duration: OUT, ease: 'power2.in' }, outAt);
            t = outAt + OUT - OVERLAP;
          } else {
            // Final word: hold slightly longer, then bloom out with the bar.
            flashTl.to(w, { autoAlpha: 0, scale: 1.07, filter: 'blur(10px)', duration: 0.26, ease: 'power2.in' }, outAt + 0.08);
            if (bar) flashTl.to(bar, { scaleX: 0, duration: 0.22, ease: 'power2.in' }, outAt + 0.08);
          }
        });
        flashTl.set(flash, { display: 'none' });
        heroTl.add(flashTl);
      } else if (flash) {
        flash.style.display = 'none';
      }
      const charsTl = gsap.timeline();
      const allChars = [];
      wordInners.forEach((word) => { word.style.transform = 'translateY(0)'; allChars.push(...splitChars(word)); });
      charsTl.to(allChars, { opacity: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power4.out', stagger: 0.025 }, 0);
      const dur = 0.6 + allChars.length * 0.025;
      // expo.out rather than the old back.out overshoot: the sub and buttons
      // settle instead of bouncing, which reads calmer under the headline.
      charsTl
        .to('.hero .hero-eyebrow', { opacity: 1, duration: 0.6, ease: 'power2.out' }, 0)
        .to('.hero-sub', { opacity: 1, y: 0, duration: 0.9, ease: 'expo.out' }, dur * 0.55)
        .to('.hero-ctas', { opacity: 1, y: 0, duration: 0.9, ease: 'expo.out' }, dur * 0.65)
        .to('.hero-scroll-indicator', { opacity: 1, duration: 0.6 }, dur * 0.8);
      heroTl.add(charsTl);
      };

      if (document.visibilityState === 'visible') {
        runHeroIntro();
      } else {
        let started = false;
        const startOnce = () => { if (!started) { started = true; runHeroIntro(); } };
        document.addEventListener('visibilitychange', function onVis() {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onVis);
          startOnce();
        }, { signal: pageCtrl.signal });
        // Failsafe, mirroring the loader's: the hero's resting CSS is
        // opacity 0, so if that event never arrives the intro must still run
        // rather than leave the headline hidden for good.
        setTimeout(startOnce, 2500);
      }
    }

    // Section heading blur-reveal
    document.querySelectorAll('.blur-reveal').forEach((heading) => {
      const chars = splitChars(heading);
      gsap.to(chars, { opacity: 1, filter: 'blur(0px)', duration: 0.5, ease: 'power3.out', stagger: 0.02,
        scrollTrigger: { trigger: heading, start: 'top 85%', toggleActions: 'play none none none' } });
    });

    // Scroll reveals
    const reveal = (sel, from) => gsap.utils.toArray(sel).forEach((el) => {
      gsap.fromTo(el, from, { opacity: 1, x: 0, y: 0, scale: 1, duration: 0.8, ease: 'back.out(1.4)',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' } });
    });
    reveal('.reveal', { opacity: 0, y: 30, scale: 0.97 });
    reveal('.reveal-left', { opacity: 0, x: -40, scale: 0.97 });
    reveal('.reveal-right', { opacity: 0, x: 40, scale: 0.97 });

    // Staggered cards / steps (guarded by element presence)
    const stagger = (sel, from, trigger, onDone) => {
      if (!document.querySelector(sel)) return;
      gsap.fromTo(sel, from, { autoAlpha: 1, x: 0, y: 0, scale: 1, scaleY: 1, duration: 0.6, stagger: 0.15,
        ease: 'back.out(1.4)', scrollTrigger: { trigger: trigger || sel, start: 'top 80%' }, onComplete: onDone });
    };
    stagger('.service-card', { autoAlpha: 0, y: 40, scale: 0.97 }, '.services-grid',
      () => document.querySelectorAll('.service-card').forEach((el) => el.classList.add('gsap-revealed')));
    stagger('.pricing-card', { autoAlpha: 0, y: 40, scale: 0.97 }, '.pricing-grid',
      () => document.querySelectorAll('.pricing-card').forEach((el) => el.classList.add('gsap-revealed')));
    stagger('.process-step', { autoAlpha: 0, x: -30, scale: 0.97 }, '.process-grid');
    if (document.querySelector('.process-line')) {
      gsap.fromTo('.process-line', { autoAlpha: 0, scaleY: 0 }, { autoAlpha: 1, scaleY: 1, duration: 0.4,
        stagger: 0.2, ease: 'power2.out', scrollTrigger: { trigger: '.process-grid', start: 'top 80%' } });
    }

    // Shader parallax
    const shaderEl = document.getElementById('hero-shader');
    if (shaderEl) {
      gsap.to(shaderEl, { yPercent: 30, ease: 'none',
        scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } });
    }

    initInteractions();
    ScrollTrigger.refresh();
  }

  /* ===== page interactions (FAQ, pricing toggle, audit, services, video, portfolio) ===== */
  function initInteractions() {
    // FAQ accordion
    document.querySelectorAll('.faq-question').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const active = item && item.classList.contains('active');
        document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('active'));
        document.querySelectorAll('.faq-question').forEach((q) => q.setAttribute('aria-expanded', 'false'));
        if (!active && item) { item.classList.add('active'); btn.setAttribute('aria-expanded', 'true'); }
      });
    });

    // Pricing monthly/upfront toggle
    const toggle = document.getElementById('pricing-toggle');
    if (toggle) {
      const labelMonthly = document.getElementById('toggle-label-monthly');
      const labelOneoff = document.getElementById('toggle-label-oneoff');
      const values = document.querySelectorAll('.pricing-value');
      const periods = document.querySelectorAll('.pricing-period');
      const commitments = document.querySelectorAll('.pricing-commitment');
      const renewals = document.querySelectorAll('.pricing-renewal');
      labelMonthly && labelMonthly.classList.add('active');
      toggle.addEventListener('click', () => {
        const upfront = toggle.getAttribute('aria-checked') === 'true';
        toggle.setAttribute('aria-checked', String(!upfront));
        const monthly = upfront;
        labelOneoff && labelOneoff.classList.toggle('active', !monthly);
        labelMonthly && labelMonthly.classList.toggle('active', monthly);
        values.forEach((el) => { el.style.opacity = '0'; setTimeout(() => {
          el.textContent = monthly ? el.dataset.monthly : el.dataset.upfront; el.style.opacity = '1'; }, 150); });
        periods.forEach((el) => { el.style.display = monthly ? '' : 'none'; });
        commitments.forEach((el) => { el.textContent = monthly ? '12-month commitment' : 'One-off build fee'; });
        renewals.forEach((el) => {
          const rate = el.dataset.renewal || '';
          // Monthly: retainer kicks in after the 12-month term. Upfront: it
          // runs from day one (the pricing note says exactly that).
          el.textContent = rate ? (monthly ? 'Then £' + rate + '/mo' : '£' + rate + '/mo from day one') : '';
        });
      });
      // The words either side of the switch select their mode directly.
      const pick = (wantUpfront) => {
        const upfrontNow = toggle.getAttribute('aria-checked') === 'true';
        if (upfrontNow !== wantUpfront) toggle.click();
      };
      labelMonthly && labelMonthly.addEventListener('click', () => pick(false));
      labelOneoff && labelOneoff.addEventListener('click', () => pick(true));
    }

    // Free-audit form -> WhatsApp
    const auditForm = document.getElementById('audit-form');
    if (auditForm) {
      const auditSuccess = document.getElementById('audit-success');
      auditForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const url = document.getElementById('audit-url').value;
        if (!url) return;
        window.open('https://wa.me/442381112819?text=' + encodeURIComponent('Hi Ryan, I would like a free website review for: ' + url), '_blank');
        auditForm.hidden = true;
        if (auditSuccess) auditSuccess.hidden = false;
      });
    }

    // Mobile: collapsible service cards + centre the Business pricing card
    if (window.innerWidth <= 768) {
      document.querySelectorAll('.service-card').forEach((card) => {
        if (card.querySelector('.service-more')) return;
        // A real button: focusable, announced, comfortable tap target.
        const moreBtn = document.createElement('button');
        moreBtn.type = 'button';
        moreBtn.className = 'service-more';
        moreBtn.textContent = 'Read more';
        moreBtn.setAttribute('aria-expanded', 'false');
        const desc = card.querySelector('p');
        if (desc) desc.after(moreBtn);
        const t = () => {
          const open = card.classList.toggle('service-expanded');
          moreBtn.setAttribute('aria-expanded', String(open));
        };
        moreBtn.addEventListener('click', t);
        const h3 = card.querySelector('h3');
        if (h3) h3.addEventListener('click', t);
      });
      const grid = document.querySelector('.pricing-grid');
      const biz = document.querySelector('[data-tier="business"]');
      if (grid && biz) requestAnimationFrame(() => {
        const gl = grid.getBoundingClientRect().left, cl = biz.getBoundingClientRect().left;
        const cw = biz.getBoundingClientRect().width, gw = grid.getBoundingClientRect().width;
        // Centre within the area NOT covered by the fixed rail, so the next
        // card's peek is actually visible rather than hidden beneath it.
        // Measure the rendered rail: it is display:none on mobile (the
        // bottom dock replaces it), where the offset must be zero.
        const railEl = document.getElementById('rail');
        const railW = railEl ? railEl.offsetWidth : 0;
        grid.scrollTo({ left: cl - gl - (gw - cw) / 2 + grid.scrollLeft + railW / 2, behavior: 'instant' });
      });
    }

    initProfileVideo();
    initPortfolio();
  }

  function initProfileVideo() {
    const wrap = document.getElementById('about-image-wrapper');
    const video = document.getElementById('profile-video');
    if (!wrap || !video) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let played = false;
    // Crossfade only once frames are actually rendering, not on play() intent.
    video.addEventListener('playing', () => wrap.classList.add('video-playing'));
    video.addEventListener('ended', () => { wrap.classList.remove('video-playing'); video.currentTime = 0; played = true; });
    const start = () => { video.currentTime = 0; video.play().catch(() => {}); };
    const stop = () => { video.pause(); wrap.classList.remove('video-playing'); video.currentTime = 0; };
    // The visible cue button makes the video discoverable and operable by
    // keyboard; hover remains a desktop nicety on top.
    const cue = wrap.querySelector('.video-cue');
    if (cue) cue.addEventListener('click', (e) => {
      e.preventDefault();
      video.paused ? start() : stop();
    });
    if (!window.matchMedia('(max-width: 768px)').matches) {
      wrap.addEventListener('mouseenter', () => { if (!reduced) start(); });
      wrap.addEventListener('mouseleave', stop);
    } else if (!reduced) {
      const ob = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (en.isIntersecting && !played) { played = true; start(); ob.disconnect(); }
      }), { threshold: 0.5, rootMargin: '0px 0px -33% 0px' });
      ob.observe(wrap);
    }
  }

  function initPortfolio() {
    const viewports = document.querySelectorAll('.browser-viewport');
    if (!viewports.length) return;
    const isMob = window.matchMedia('(max-width: 768px)').matches;
    // Reduced motion removes the seven-second pan, not the work: the live
    // iframe still mounts and the poster still shows, they just hold still.
    const noMo = document.documentElement.classList.contains('no-motion');
    const SITE_WIDTH = 1024, HERO_HEIGHT = 1366, PAN_MS = 7000;
    const calcScale = (vp) => vp.clientWidth / SITE_WIDTH;

    viewports.forEach((vp) => {
      const siteUrl = vp.dataset.site;
      const stack = vp.querySelector('.browser-stack');
      const poster = vp.querySelector('.browser-poster');
      // Pan works on the poster alone; the live iframe is an enhancement only
      // mounted for sites that allow framing (some sites send X-Frame-Options).
      if (!stack || !poster) return;
      let iframe = null, scale = calcScale(vp), animId = null, top = 0, mobileDone = false, panning = false;
      const apply = (t) => { stack.style.transform = `translateY(${t}px) scale(${scale})`; };
      // Normalise by the poster's real width: a capture that came out wider
      // than SITE_WIDTH (horizontal page overflow) renders shorter in the
      // card, and assuming SITE_WIDTH would overshoot the pan past the end.
      const maxPan = () => {
        const w = poster.naturalWidth || SITE_WIDTH;
        return Math.max(0, poster.naturalHeight * (SITE_WIDTH / w) * scale - vp.offsetHeight);
      };
      function mountIframe() {
        if (iframe) return;
        iframe = document.createElement('iframe');
        iframe.src = siteUrl; iframe.loading = 'lazy'; iframe.title = poster.alt || 'Site preview';
        iframe.tabIndex = -1; iframe.setAttribute('aria-hidden', 'true');
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
        Object.assign(iframe.style, { position: 'absolute', top: '0', left: '0', width: SITE_WIDTH + 'px',
          height: HERO_HEIGHT + 'px', border: '0', pointerEvents: 'none', opacity: '0', transition: 'opacity 0.5s ease-out', zIndex: '2' });
        iframe.addEventListener('load', () => { if (iframe && !panning) iframe.style.opacity = '1'; });
        stack.appendChild(iframe);
      }
      apply(0);
      function startPan() {
        if (noMo) return;
        if (animId) return; if (isMob && mobileDone) return;
        // The card is exactly as tall as the scaled iframe, so with a live
        // frame mounted there was nowhere to pan to and hovering did nothing.
        // Fade the frame out instead and scroll the full-page poster beneath
        // it: same page, same width, so the swap is invisible at rest and
        // there is no seam to cross.
        panning = true;
        if (iframe) { iframe.style.transition = 'opacity 0.25s ease-out'; iframe.style.opacity = '0'; }
        const target = -maxPan();
        if (target === 0) {
          // maxPan is 0 while a loading="lazy" poster is still decoding
          // (naturalHeight 0). Re-arm once it lands so the reveal is not lost
          // on slow connections, mirroring the desktop mountIframe guard.
          if (poster && !(poster.complete && poster.naturalHeight > 0)) {
            poster.addEventListener('load', startPan, { once: true });
          }
          return;
        }
        const start = performance.now(), from = top, dist = target - from;
        stack.classList.add('panning');
        const finish = () => requestAnimationFrame(() => stack.classList.remove('panning'));
        function step(now) {
          const t = Math.min((now - start) / PAN_MS, 1);
          const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          top = from + dist * e; apply(top);
          if (t < 1) animId = requestAnimationFrame(step);
          else { animId = null; if (isMob) { mobileDone = true; setTimeout(() => {
            stack.style.transition = 'transform 0.9s ease-out'; top = 0; apply(top);
            setTimeout(() => { stack.style.transition = ''; finish(); }, 1000); }, 700); } else finish(); }
        }
        stack.style.transition = ''; animId = requestAnimationFrame(step);
        panFrames.push(() => { if (animId) { cancelAnimationFrame(animId); animId = null; } });
      }
      function resetPan() {
        if (animId) { cancelAnimationFrame(animId); animId = null; }
        panning = false;
        stack.style.transition = 'transform 0.6s ease-out'; top = 0; apply(top);
        // Bring the live frame back only once the poster is home again, so the
        // fade-in never lands over a half-scrolled screenshot.
        if (iframe) setTimeout(() => { if (iframe && !panning) iframe.style.opacity = '1'; }, 620);
        setTimeout(() => stack.classList.remove('panning'), 700);
      }
      // Scoped to the page lifetime: without the signal these accumulate on
      // every return visit to the home page and pin detached DOM in memory.
      window.addEventListener('resize', () => { scale = calcScale(vp); apply(top); },
        pageCtrl ? { signal: pageCtrl.signal } : undefined);
      if (!isMob) {
        const frameOb = new IntersectionObserver((entries, ob) => entries.forEach((en) => {
          if (en.isIntersecting) {
            // Only embed a live frame where the site permits it. A site whose CSP
            // frame-ancestors restricts embedding to a single origin is flagged
            // data-frame-on="<host>"; the live frame mounts on that production host
            // only, and everywhere else (localhost, previews) the full-page
            // screenshot pans instead, so the card is never blank.
            var frameOn = vp.dataset.frameOn;
            var hostOk = !frameOn || location.hostname === frameOn;
            if (siteUrl && hostOk) {
              if (poster.complete && poster.naturalWidth > 0) mountIframe();
              else poster.addEventListener('load', mountIframe, { once: true });
            }
            ob.unobserve(vp);
          }
        }), { rootMargin: '200px' });
        frameOb.observe(vp);
        pageObservers.push(frameOb);
        const card = vp.closest('.project-browser');
        if (card) { card.addEventListener('mouseenter', startPan); card.addEventListener('mouseleave', resetPan); }
      }
      vp._startPan = startPan; vp._resetPan = resetPan;
    });

    if (isMob && !noMo) {
      let active = null;
      const ob = new IntersectionObserver((entries) => entries.forEach((en) => {
        const t = en.target;
        if (en.isIntersecting) { if (active && active !== t) active._resetPan(); active = t; t._startPan(); }
        else { t._resetPan(); if (active === t) active = null; }
      }), { threshold: 0.4 });
      viewports.forEach((vp) => ob.observe(vp));
      pageObservers.push(ob);
    }
  }

  /* ===== boot + View Transition lifecycle ===== */
  function setupPage() {
    if (typeof window.gsap === 'undefined' || typeof window.ScrollTrigger === 'undefined' || typeof window.Lenis === 'undefined') {
      // Failsafe: if the CDN libraries never arrive (blocker, outage), fall
      // back to the static .no-motion presentation instead of a blank page.
      if (++gsapTries > 30) {
        document.documentElement.classList.add('no-motion');
        const L = document.getElementById('loader');
        if (L) { L.style.display = 'none'; L.setAttribute('aria-hidden', 'true'); }
        wireRail();
        applyRailState();
        document.querySelectorAll('img[loading="lazy"]').forEach((i) => { i.loading = 'eager'; });
        initInteractions();
        return;
      }
      return setTimeout(setupPage, 80);
    }
    gsapTries = 0;
    // Honour reduced-motion preferences with the same static mode the
    // ?nomotion test flag uses.
    const noMotion = location.search.indexOf('nomotion') !== -1
      || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (noMotion) document.documentElement.classList.add('no-motion');
    window.gsap.registerPlugin(window.ScrollTrigger);
    // Lenis smooths the scroll itself, so it is motion: someone who asked for
    // reduced motion gets the browser's own scrolling, not a hijacked one.
    if (!noMotion) ensureLenis();
    wireRail();
    killTriggers();
    if (pageCtrl) pageCtrl.abort();
    pageCtrl = new AbortController();
    if (!noMotion) mountShader();
    applyRailState();
    if (noMotion) {
      // Test mode: skip the loader and scroll-reveal hiding so the whole
      // page is captured statically. CSS (.no-motion) makes content visible.
      const L = document.getElementById('loader');
      if (L) { L.style.display = 'none'; L.setAttribute('aria-hidden', 'true'); }
      document.querySelectorAll('img[loading="lazy"]').forEach((i) => { i.loading = 'eager'; });
      initInteractions();
      return;
    }
    if (!booted) {
      booted = true;
      let seen = false;
      try { seen = !!sessionStorage.getItem('kombu-seen'); sessionStorage.setItem('kombu-seen', '1'); } catch (e) {}
      if (seen) {
        // Loader already shown this session (e.g. a full reload or the
        // photography page): skip it and reveal content immediately.
        const L = document.getElementById('loader');
        if (L) { L.style.display = 'none'; L.setAttribute('aria-hidden', 'true'); }
        initAnimations();
      } else {
        playLoaderThen(initAnimations);
      }
    } else initAnimations();
  }

  document.addEventListener('astro:before-swap', () => {
    disposeShader();
    killTriggers();
    // An open lightbox must be closed by its own teardown, or Lenis stays
    // stopped and the destination page cannot be scrolled at all.
    if (closeLightbox) { closeLightbox(); closeLightbox = null; }
    // IntersectionObservers are not tied to the AbortController, so they have
    // to be disconnected by hand or they pin detached cards on every visit.
    pageObservers.forEach((ob) => ob.disconnect());
    pageObservers = [];
    panFrames.forEach((cancel) => cancel());
    panFrames = [];
    if (pageCtrl) { pageCtrl.abort(); pageCtrl = null; }
    collapseRail(); // persisted rail must enter the new page closed
  });
  document.addEventListener('astro:after-swap', () => {
    // Astro's router has already put the page where it should be (top for a
    // new navigation, the saved position for back/forward). Just bring Lenis
    // in line with it rather than forcing everything back to 0.
    if (window.__lenis) window.__lenis.scrollTo(window.scrollY, { immediate: true, force: true });
    applyRailState();
  });
  document.addEventListener('astro:page-load', setupPage);
</script>
