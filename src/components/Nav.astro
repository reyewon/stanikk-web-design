---
// Shared floating pill nav for every page. `current` marks the active
// link with aria-current="page"; the home link always points at /.
interface Props { current: 'home' | 'web-design' | 'design' | 'photography' | 'marketing' | 'about'; }
const { current } = Astro.props as Props;

const nav = [
  { id: 'web-design', href: '/web-design', label: 'Websites' },
  { id: 'design', href: '/design', label: 'Design' },
  { id: 'photography', href: '/photography', label: 'Photography' },
  { id: 'marketing', href: '/marketing', label: 'Marketing' },
  { id: 'about', href: '/about', label: 'About' },
];
const WA = 'https://wa.me/442381112819';
---
<nav class="nav" aria-label="Primary">
  <a href="/" class="nav-mark" aria-label="Kombu, home" aria-current={current === 'home' ? 'page' : undefined}>Kombu</a>
  <button class="pill pill--sm nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
  <ul class="nav-links" id="nav-links">
    {nav.map((n) => <li><a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a></li>)}
  </ul>
  <a href={WA} class="pill pill--fill pill--sm" target="_blank" rel="noopener">WhatsApp me</a>
</nav>
