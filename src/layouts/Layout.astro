---
// Live site layout. Built from zero rather than layered on the retired v1
// look (no global.css / components.css / studio.css, no GSAP/shader runtime),
// but the document head is the same production SEO head the v1 Layout.astro
// carried: meta, Open Graph, Twitter, geo, PWA, favicons and the JSON-LD
// entity graph, so search engines and AI answer engines see one consistent
// site across the swap.
import '../styles/site.css';
import { googleReviewsUrl, reviews } from '../data/reviews';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
  ogType?: string;
  extraSchema?: any[];
  hasReviews?: boolean;
  noindex?: boolean;
}

const siteUrl = "https://kombu.uk";
const siteName = "Kombu";
const {
  title,
  description = "A one-person creative studio in Southampton: web design, graphic design, commercial photography, marketing and the infrastructure that ties a business together.",
  canonical = new URL(Astro.url.pathname, siteUrl).href,
  ogImage = `${siteUrl}/images/og-kombu.jpg?v=3`,
  ogImageWidth = "1200",
  ogImageHeight = "630",
  ogImageAlt = "Kombu: websites, photography, graphic design and marketing, a creative studio in Southampton",
  ogType = "website",
  extraSchema = [],
  hasReviews = false,
  noindex = false,
} = Astro.props;

// Shared entity graph, present on every page so the business/person stays
// consistent. Pages add WebPage / Service / BreadcrumbList / FAQPage via extraSchema.
const baseGraph = [
  {
    "@type": "WebSite",
    "@id": "https://kombu.uk/#website",
    "url": "https://kombu.uk",
    "name": "Kombu",
    "description": "Creative, design and marketing studio in Southampton.",
    "publisher": { "@id": "https://kombu.uk/#business" },
    "inLanguage": "en-GB"
  },
  {
    "@type": ["ProfessionalService", "LocalBusiness"],
    "@id": "https://kombu.uk/#business",
    "name": "Kombu",
    "alternateName": ["Kombu Studio", "Kombu Web Design", "Kombu Web Design Southampton"],
    "disambiguatingDescription": "Kombu is a one-person creative studio in Southampton, England, covering web design, graphic design, commercial photography and marketing. It is named after kombu kelp as a metaphor for being the quiet foundation beneath a brand. It is a creative and marketing studio, not a food, seaweed or sushi product.",
    "description": "A one-person creative studio in Southampton: web design and development, graphic design and branding, commercial photography, and marketing, plus the practical infrastructure that connects them. Direct, personal service from a designer with almost two decades of experience.",
    "slogan": "One mind, the whole stack.",
    "url": "https://kombu.uk",
    "numberOfEmployees": 1,
    "telephone": "+442381112819",
    "email": "design@kombu.uk",
    "image": "https://kombu.uk/images/ryan-stanikk.jpg",
    "logo": "https://kombu.uk/favicon-512.png",
    "priceRange": "££",
    "currenciesAccepted": "GBP",
    "paymentAccepted": "Bank Transfer",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Southampton",
      "addressRegion": "Hampshire",
      "addressCountry": "GB"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 50.9097, "longitude": -1.4044 },
    "founder": { "@id": "https://kombu.uk/#person" },
    "areaServed": [
      { "@type": "City", "name": "Southampton", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Eastleigh", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Winchester", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Portsmouth", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Fareham", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Romsey", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Chandler's Ford", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Hedge End", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "City", "name": "Totton", "containedInPlace": { "@type": "AdministrativeArea", "name": "Hampshire" } },
      { "@type": "AdministrativeArea", "name": "Hampshire" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": ["Web Design", "Web Development", "Graphic Design", "Brand Identity Design", "Logo Design", "Menu Design", "Print Design", "Commercial Photography", "Marketing Strategy", "Local SEO", "Hospitality Marketing"],
    "knowsAbout": ["Web Design", "Responsive Web Design", "Web Development", "Graphic Design", "Brand Identity", "Logo Design", "Editorial Design", "Menu Design", "Commercial Photography", "Food Photography", "Marketing Strategy", "Local SEO", "Hospitality Marketing", "Small Business Marketing"],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+442381112819",
      "email": "design@kombu.uk",
      "contactType": "customer service",
      "areaServed": "GB",
      "availableLanguage": "English"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Studio Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Design & Development", "url": "https://kombu.uk/web-design" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Graphic Design & Branding", "url": "https://kombu.uk/design" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Photography", "url": "https://kombu.uk/photography" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Marketing & Hospitality Health Check", "url": "https://kombu.uk/marketing" } }
      ]
    },
    "hasMap": googleReviewsUrl,
    ...(hasReviews ? {
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": 5,
        "reviewCount": reviews.length,
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": reviews.map((review) => ({
        "@type": "Review",
        "author": { "@type": "Person", "name": review.name },
        "reviewRating": { "@type": "Rating", "ratingValue": review.rating, "bestRating": "5" },
        "reviewBody": review.quote
      }))
    } : {}),
    "sameAs": [
      googleReviewsUrl,
      "https://www.instagram.com/kombu.uk/",
      "https://uk.linkedin.com/in/ryanstanikk",
      "https://www.instagram.com/ryanstanikkphotography/",
      "https://medium.com/@ryanstanikkphotography",
      "https://wa.me/442381112819",
      "https://ryanstanikk.co.uk"
    ]
  },
  {
    "@type": "Person",
    "@id": "https://kombu.uk/#person",
    "name": "Ryan Stanikk",
    "jobTitle": "Designer, Photographer & Web Developer",
    "description": "Southampton-based designer, commercial photographer and web developer with almost two decades of design and marketing experience, running Kombu as a one-person cross-disciplinary studio.",
    "image": "https://kombu.uk/images/ryan-stanikk.jpg",
    "url": "https://kombu.uk/about",
    "worksFor": { "@id": "https://kombu.uk/#business" },
    "sameAs": [
      "https://uk.linkedin.com/in/ryanstanikk",
      "https://www.instagram.com/ryanstanikkphotography/",
      "https://medium.com/@ryanstanikkphotography",
      "https://ryanstanikk.co.uk"
    ],
    "knowsAbout": ["Web Design", "Graphic Design", "Commercial Photography", "Web Development", "Marketing", "Brand Identity", "SEO"]
  }
];

// Freshness signal. AI answer engines weight recency heavily and undated pages
// lose to dated ones, so every WebPage node carries a dateModified. Build time
// is the honest source here: git is not, because most page files are untracked
// and the site is redeployed whenever content changes.
const buildISO = new Date().toISOString();
const datedSchema = extraSchema.map((node) =>
  node["@type"] === "WebPage" ? { ...node, dateModified: buildISO } : node
);

const jsonLd = { "@context": "https://schema.org", "@graph": [...baseGraph, ...datedSchema] };
// Dev only: the clay arranger (dev-tools/clay-arranger.js plus its harness, dev-tools/arrange.html),
// opened by adding ?arrange to any page under `npm run dev`. import.meta.env.DEV is false in a build, so none of this ships.
let clayArranger = '';
if (import.meta.env.DEV) {
  const fs = await import('node:fs');
  const dir = process.cwd() + '/dev-tools';
  const names = fs.readdirSync(dir + '/clay-library').filter((f) => f.endsWith('.webp')).map((f) => f.slice(0, -5));
  const lib = JSON.stringify({ base: '/@fs' + dir + '/clay-library/', harness: '/@fs' + dir + '/arrange.html', names: names });
  clayArranger = 'window.__clayLib=' + lib + ';\n' + fs.readFileSync(dir + '/clay-arranger.js', 'utf8');
}
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- After the first visit of a session, skip the loader before paint (no flash) -->
    <script is:inline>try{if(sessionStorage.getItem('kombu-seen'))document.documentElement.classList.add('kombu-seen');}catch(e){}</script>

    <!-- Google tag (gtag.js) - GA4. Only the live site reports: localhost, previews and
         pages.dev copies stay out of the numbers, but gtag() exists everywhere so event calls never fail. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      if (/^(www\.)?kombu\.uk$/.test(location.hostname)) {
        var g = document.createElement('script'); g.async = true;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=G-5H2CJESBZ0';
        document.head.appendChild(g);
        gtag('js', new Date());
        gtag('config', 'G-5H2CJESBZ0');
      }
      // Every WhatsApp, email and phone tap is sent as contact_click (a GA4 key
      // event) with the route, where on the page it sat and the page itself.
      // Only the route is sent, never the link itself, so a quote summary
      // riding on a wa.me or mailto link never reaches GA4.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var h = a.getAttribute('href') || '';
        var method = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(h) ? 'whatsapp' : /^mailto:/i.test(h) ? 'email' : /^tel:/i.test(h) ? 'phone' : '';
        if (!method) return;
        var placement = a.closest('.quote-result') ? 'quote_calculator' : a.closest('nav, #menu') ? 'nav' : a.closest('footer') ? 'footer' : a.closest('#contact') ? 'contact_card' : 'page';
        gtag('event', 'contact_click', { method: method, placement: placement, page_path: location.pathname });
      }, true);
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ryan Stanikk" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="GB-HAM" />
    <meta name="geo.placename" content="Southampton" />
    <meta name="geo.position" content="50.9097;-1.4044" />
    <meta name="ICBM" content="50.9097, -1.4044" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Theme & PWA -->
    <meta name="theme-color" content="#141210" />
    <meta name="msapplication-TileColor" content="#1A1412" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Kombu" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Kombu" />

    <!-- Favicon: Ryan's Kombu knot, four strands in the four compartment
         colours. The SVG is his own export and what modern browsers use; the
         PNGs and the ico are rendered from it and keep its transparency. The
         apple touch and maskable icons are his cream artwork instead, because
         iOS composites a transparent icon onto black. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=3" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=3" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />

    <slot name="head" />

    <!-- Fonts: all self-hosted. Preload the faces used above the fold
         (display headline weights + body) so the first layout is already in
         final metrics - no swap, no layout shift. -->
    <link rel="preload" href="/fonts/SupermassiveRS-III.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SupermassiveRS-II.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-300.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>@font-face{font-family:'Supermassive RS';src:url('/fonts/SupermassiveRS-I.woff2') format('woff2');font-weight:700;font-display:swap;font-style:normal}@font-face{font-family:'Supermassive RS';src:url('/fonts/SupermassiveRS-II.woff2') format('woff2');font-weight:800;font-display:swap;font-style:normal}@font-face{font-family:'Supermassive RS';src:url('/fonts/SupermassiveRS-III.woff2') format('woff2');font-weight:900;font-display:swap;font-style:normal}@font-face{font-family:'Switzer';src:url('/fonts/switzer-300.woff2') format('woff2');font-weight:300;font-display:swap;font-style:normal}@font-face{font-family:'Switzer';src:url('/fonts/switzer-400.woff2') format('woff2');font-weight:400;font-display:swap;font-style:normal}@font-face{font-family:'Switzer';src:url('/fonts/switzer-500.woff2') format('woff2');font-weight:500;font-display:swap;font-style:normal}@font-face{font-family:'Supermassive FB';src:local('Arial');size-adjust:88.29%;ascent-override:101.93%;descent-override:28.32%;line-gap-override:0%}@font-face{font-family:'Switzer FB';src:local('Arial');size-adjust:98.45%;ascent-override:99.55%;descent-override:25.39%;line-gap-override:0%}</style>

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- No-JS fallback: the floating nav starts hidden (opacity 0) awaiting a
         scroll-triggered JS class, and the home page's pinned intro relies on
         JS to release its scroll padding, so without this a no-JS visitor
         gets an invisible nav and ~200vh of empty scroll on '/'. Mirrors the
         same resting state the .no-motion class already renders. -->
    <noscript>
      <style>
        .nav { opacity: 1 !important; transform: translate(-50%, 0) !important; }
        .intro { height: auto !important; }
        .intro-stage { position: static !important; height: auto !important; overflow: visible !important; }
        .wm { transform: none !important; }
        .wm span { animation: none !important; }
        .tray-grid.is-armed .cell { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <script is:inline>
      // Same static test path the main site uses: ?nomotion or a reduced-motion
      // preference renders everything in its resting state.
      // Always open at the top on the home page, since the intro is the first
      // thing it says and a reload landing mid-page would skip it. Interior
      // pages must not fight a hash link (e.g. /web-design#pricing).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      function isHome() { return location.pathname.replace(/\/$/, '') === ''; }
      function toTop() { if (isHome() && !location.hash) scrollTo(0, 0); }
      toTop();
      addEventListener('pageshow', function (event) { if (event.persisted) toTop(); });
      if (location.search.indexOf('nomotion') !== -1 || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('no-motion');
        // Static test renders want every image present, same as the main site.
        addEventListener('DOMContentLoaded', function () { document.querySelectorAll('img[loading="lazy"]').forEach(function (i) { i.loading = 'eager'; }); });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
    <script is:inline src="/vendor/lenis-1.3.26.min.js"></script>
    <script is:inline>
      // Lenis and the nav reveal run on EVERY page, intro or not: an interior
      // page has no #intro to pop the nav in via the pinned sequence, so it
      // needs its own arm-on-load / arm-on-scroll logic. Lenis exposes itself
      // as window.__lenis so the lightbox can stop/start it while open.
      (function () {
        var html = document.documentElement, nav = document.querySelector('.nav'), intro = document.getElementById('intro');
        var noMo = html.classList.contains('no-motion');
        function showNav() { if (nav && !nav.classList.contains('is-shown')) nav.classList.add('is-shown'); }
        if (!noMo && typeof Lenis !== 'undefined') {
          var lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
          window.__lenis = lenis;
          (function raf(t) { lenis.raf(t); requestAnimationFrame(raf); })(0);
        }
        if (noMo || !intro) { showNav(); return; }
        // A page with #intro (home) lets the pinned sequence below reveal the
        // nav on first scroll instead, so it does not show it immediately.
      })();
    </script>
    <script is:inline>
      // The intro is one way. Progress p runs 0 to 1 across the pinned
      // stage's scroll budget. Until the wordmark has risen (p 0.2) its slide
      // follows the scroll; after that it locks at the top. Each compartment
      // pops in once, when p first crosses its threshold (0.24, 0.40, 0.56,
      // 0.72), and stays in; scrolling back never undoes it. The nav arrives
      // on the first scroll. Phones and reduced motion skip the pin: phones
      // pop cells in as they arrive, reduced motion shows everything.
      // Interior pages have no #intro, so this whole sequence is a no-op there
      // (the nav and Lenis are handled by the IIFE above instead).
      (function () {
        var html = document.documentElement, intro = document.getElementById('intro'), wm = document.getElementById('wm');
        var tray = document.getElementById('tray'), nav = document.querySelector('.nav');
        var cells = tray ? Array.prototype.slice.call(tray.querySelectorAll('.cell')) : [];
        if (!intro || !wm || !cells.length) return;
        var noMo = html.classList.contains('no-motion');
        var pinned = !noMo && matchMedia('(min-width: 1025px)').matches;
        var clamp = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
        var easeOut = function (t) { return 1 - Math.pow(1 - t, 3); };
        function showNav() { if (nav && !nav.classList.contains('is-shown')) nav.classList.add('is-shown'); }
        if (noMo) { showNav(); return; }
        addEventListener('scroll', function onFirst() { if (scrollY > 24) { showNav(); removeEventListener('scroll', onFirst); } }, { passive: true });
        if (scrollY > 24) showNav();
        if (pinned) {
          tray.classList.add('is-armed');
          var y0 = 0, s0 = 1, range = 1, ticking = false, risen = false, done = 0, finished = false;
          function finish() {
            finished = true;
            removeEventListener('scroll', onScroll);
            intro.classList.add('is-done');
            // The stage now sits statically at the top of the document, one
            // viewport tall, exactly where it was pinned, so the scroll
            // lands on 0 with nothing visibly moving.
            if (window.__lenis) window.__lenis.scrollTo(0, { immediate: true, force: true }); else scrollTo(0, 0);
          }
          function measure() {
            wm.style.setProperty('--wm-y', '0px'); wm.style.setProperty('--wm-s', '1');
            wm.classList.add('measuring');           /* letters at rest, not mid-land */
            var vh = innerHeight, rect = wm.getBoundingClientRect(), top = rect.top + scrollY;
            var r = document.createRange(); r.selectNodeContents(wm);
            s0 = Math.min(1.9, (innerWidth - 2 * 28) / r.getBoundingClientRect().width);
            y0 = (vh / 2 - (wm.offsetHeight * s0) / 2) - top;
            wm.classList.remove('measuring');
            range = intro.offsetHeight - vh;
          }
          function frame() {
            ticking = false;
            var p = clamp(scrollY / range);
            intro.dataset.p = p.toFixed(3);
            if (!risen) {
              var a = easeOut(clamp(p / 0.2));
              wm.style.setProperty('--wm-y', (y0 * (1 - a)).toFixed(1) + 'px');
              wm.style.setProperty('--wm-s', (s0 - (s0 - 1) * a).toFixed(4));
              if (p >= 0.2) { risen = true; wm.style.setProperty('--wm-y', '0px'); wm.style.setProperty('--wm-s', '1'); }
            }
            while (done < cells.length && p >= 0.24 + done * 0.16) { cells[done].classList.add('is-in'); done++; }
            if (!finished && done === cells.length) finish();
          }
          function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
          measure(); frame();
          addEventListener('scroll', onScroll, { passive: true });
          addEventListener('resize', function () { if (!risen) { measure(); frame(); } });
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { if (!risen) { measure(); frame(); } });
        } else {
          tray.classList.add('is-armed');
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
          }, { threshold: 0.25 });
          // Anything already inside the first viewport shows at once; only the
          // cells below it wait for the observer. Holding a visible cell at
          // opacity 0 until the observer fired was the page's largest paint.
          cells.forEach(function (c) { if (c.getBoundingClientRect().top < innerHeight) c.classList.add('is-in'); else io.observe(c); });
        }
      })();
    </script>
    <script is:inline>
      // Portrait parallax: as the about card crosses the viewport the cutout
      // drifts a few pixels against the card, so it reads as a layer sitting
      // on it. Runs only while the card is on screen, never under .no-motion.
      (function () {
        var wrap = document.getElementById('portrait'), cut = wrap && wrap.querySelector('.portrait-cut');
        if (!wrap || !cut || document.documentElement.classList.contains('no-motion')) return;
        var live = false, queued = false;
        function settle() {
          queued = false;
          var r = wrap.getBoundingClientRect();
          var p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
          p = p < -1 ? -1 : p > 1 ? 1 : p;
          wrap.style.setProperty('--par-cut', (p * -16).toFixed(1) + 'px');
        }
        function onScroll() { if (live && !queued) { queued = true; requestAnimationFrame(settle); } }
        new IntersectionObserver(function (es) { live = es[0].isIntersecting; if (live) settle(); }, { rootMargin: '80px' }).observe(wrap);
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
      })();
    </script>
    <script is:inline>
      // Clay props (Clay.astro): each one settles in (fade and a small scale up)
      // the first time it comes on screen, then drifts a few pixels and a degree
      // or two against the page while it is on screen, like the portrait. Never
      // under .no-motion: the props then simply sit still, as they do without JS.
      (function () {
        var props = [].slice.call(document.querySelectorAll('.clay'));
        if (!props.length || document.documentElement.classList.contains('no-motion')) return;
        document.documentElement.classList.add('clay-armed');
        var live = [], queued = false;
        function drift() {
          queued = false;
          live.forEach(function (el) {
            var r = el.getBoundingClientRect();
            var p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
            p = p < -1 ? -1 : p > 1 ? 1 : p;
            el.style.setProperty('--clay-dy', (p * -20).toFixed(1) + 'px');
            el.style.setProperty('--clay-dr', (p * 6).toFixed(2) + 'deg');
          });
        }
        function onScroll() { if (live.length && !queued) { queued = true; requestAnimationFrame(drift); } }
        var watch = new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            var i = live.indexOf(en.target);
            if (en.isIntersecting && i < 0) live.push(en.target);
            if (!en.isIntersecting && i > -1) live.splice(i, 1);
          });
          onScroll();
        }, { rootMargin: '80px 0px' });
        var enter = new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            if (!en.isIntersecting) return;
            enter.unobserve(en.target);
            // a frame after arming, so a prop already on screen at load still plays its entrance
            requestAnimationFrame(function () { en.target.classList.add('is-in'); });
          });
        }, { threshold: 0.35 });
        props.forEach(function (el) { watch.observe(el); enter.observe(el); });
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
      })();
    </script>
    <script is:inline>
      // Phone menu: the Menu pill opens the tray sheet, Close, Escape or a
      // link closes it. Page scroll (and Lenis) is held while it is open.
      (function () {
        var btn = document.querySelector('.nav-toggle'), menu = document.getElementById('menu');
        if (!btn || !menu) return;
        var closeBtn = menu.querySelector('.menu-close');
        function open() {
          menu.hidden = false;
          requestAnimationFrame(function () { if (btn.getAttribute('aria-expanded') === 'true') menu.classList.add('is-open'); });
          btn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (window.__lenis) window.__lenis.stop();
          if (closeBtn) closeBtn.focus();
        }
        function close() {
          menu.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          if (window.__lenis) window.__lenis.start();
          setTimeout(function () { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 230);
          btn.focus();
        }
        btn.addEventListener('click', function () { menu.hidden ? open() : close(); });
        if (closeBtn) closeBtn.addEventListener('click', close);
        menu.querySelectorAll('.menu-tile').forEach(function (a) { a.addEventListener('click', function () { document.body.style.overflow = ''; }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hidden) close(); });
      })();
    </script>
    <script is:inline>
      // Lightbox: any [data-lightbox] wrapper opens its image full size in a
      // fixed ink overlay. Used on /design and /photography. It stays on under
      // .no-motion: reduced motion means no fade, not no enlarging, and the
      // tiles still show a zoom-in cursor there. site.css drops the fade.
      (function () {
        var opener = null, overlay = null;
        function build() {
          overlay = document.createElement('div');
          overlay.className = 'lightbox';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          var img = document.createElement('img');
          overlay.appendChild(img);
          var close = document.createElement('button');
          close.type = 'button';
          close.className = 'pill lightbox-close';
          close.textContent = 'Close';
          overlay.appendChild(close);
          close.addEventListener('click', hide);
          overlay.addEventListener('click', function (e) { if (e.target === overlay) hide(); });
          document.body.appendChild(overlay);
          return overlay;
        }
        function show(src, alt, trigger) {
          opener = trigger;
          if (!overlay) build();
          var img = overlay.querySelector('img');
          img.src = src; img.alt = '';
          overlay.setAttribute('aria-label', alt || 'Enlarged image');
          overlay.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          if (window.__lenis) window.__lenis.stop();
          overlay.querySelector('.lightbox-close').focus();
          document.addEventListener('keydown', onKey);
        }
        function hide() {
          if (!overlay || !overlay.classList.contains('is-open')) return;
          overlay.classList.remove('is-open');
          document.body.style.overflow = '';
          if (window.__lenis) window.__lenis.start();
          document.removeEventListener('keydown', onKey);
          if (opener) opener.focus();
        }
        function onKey(e) { if (e.key === 'Escape') hide(); }
        document.addEventListener('click', function (e) {
          var img = e.target.closest('[data-lightbox] img');
          if (!img) return;
          e.preventDefault();
          // srcset thumbnails are small WebP copies; the src is the full-size original
          show(img.srcset ? img.src : (img.currentSrc || img.src), img.alt, img);
        });
      })();
    </script>
    <!-- Register the service worker so Android Chrome marks the site installable. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
    {clayArranger && <script is:inline set:html={clayArranger} />}
  </body>
</html>
