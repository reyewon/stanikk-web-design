---
import Layout from '../layouts/Layout.astro';
import '../styles/home-preview.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import Reviews from '../components/Reviews.astro';
import ContactCard from '../components/ContactCard.astro';
import WorkPreview from '../components/WorkPreview.astro';
import Img from '../components/Img.astro';

const title = "Kombu | Creative, Design & Marketing Studio in Southampton";
const description = "A one-person creative studio in Southampton: web design, graphic design, commercial photography and marketing that finally pull in the same direction.";

// Every fact below is lifted from the live site. Nothing new is claimed.
// Each cell shows two stacked examples of the work: front and back.
const cells = [
  { id: 'web', href: '/web-design/', title: 'Websites', fact: 'From £49 a month', body: 'Bespoke, fast, design-led websites and web apps. No templates and no agency runaround, just', bodyLink: { text: 'web design in Southampton', href: '/web-design/' }, bodyAfter: ' that does its job.',
    front: { img: '/images/preview/msnry.webp', alt: 'The msnry app website, built by Kombu' },
    back: { img: '/images/preview/the-grand.webp', alt: 'The Grand Southampton website, designed by Kombu' } },
  { id: 'photo', href: '/photography/', title: 'Photography', fact: '2 hours from £275', body: 'Food, interiors, product and brand photography that earns the booking.',
    front: { img: '/images/tray/photo-a.webp', alt: 'A bowl of golden battered bites with chilli and coriander, restaurant food photography by Kombu' },
    back: { img: '/images/tray/photo-b.webp', alt: 'A smiling woman in a striped cardigan holding a mug, outdoor portrait photography by Kombu' } },
  { id: 'design', href: '/design/', title: 'Graphic design', fact: '20 years of design', body: 'Brand identities, menus, print and editorial, with two decades behind the pen.',
    front: { img: '/images/design/kwackers-burgers.jpg', alt: 'The Kwackers burger menu, designed by Kombu' },
    back: { img: '/images/design/ideal-produce-spread-1.jpg', alt: 'An Ideal Produce catalogue spread, designed by Kombu' } },
  { id: 'mktg', href: '/marketing/', title: 'Marketing & infrastructure', fact: 'Health Check from £295', body: 'Strategy, ads, social and local SEO, plus the systems, sourcing and tools that tie a business together.',
    front: { img: '/images/design/padharo-menu-2026-front.jpg', alt: 'The front of the 2026 Padharo menu, designed by Kombu' },
    back: { img: '/images/tray/mktg-meeting.webp', alt: 'Ryan Stanikk at a cafe table, listening across two coffees' } },
];

const work = [
  { name: 'Grumpy Monkey', slug: 'grumpy-monkey', cs: '/work/mustang-group/#venues', url: 'https://www.grumpy-monkey.co.uk', alt: 'Grumpy Monkey late night cocktail bar website in Southampton', line: 'A late night bar that trades on neon and noise. Weekly events, menus and table bookings, quick on a phone.' },
  { name: 'Padharo', slug: 'padharo', cs: '/work/padharo/', url: 'https://www.padharo.co.uk', alt: 'Padharo vegetarian Indian restaurant website with reservations and menus', line: 'Award-winning vegetarian Indian restaurant. Reservations, menus, and room for the photography to work.' },
  { name: 'msnry', slug: 'msnry', url: 'https://msnry.app', alt: 'The msnry website: photographs laid out as one seamless Instagram carousel', line: 'My own web app. It lays your photos out as one seamless Instagram carousel, in the browser, with nothing uploaded.' },
  // tablets only: two columns of three left msnry on its own, so a fourth site squares the grid there
  { name: "Ennio's", slug: 'ennios', cs: '/work/mustang-group/#venues', url: 'https://www.ennios.co.uk', alt: "Ennio's Italian restaurant and boutique rooms website on Southampton's Town Quay", line: 'An Italian restaurant with ten boutique rooms in a Victorian warehouse on Town Quay. The restaurant, the rooms and table bookings, all in one place.', tabletOnly: true },
];

const WA = 'https://wa.me/442381112819';

const extraSchema = [
  {
    "@type": "WebPage",
    "@id": "https://kombu.uk/#webpage",
    "url": "https://kombu.uk/",
    "name": title,
    "isPartOf": { "@id": "https://kombu.uk/#website" },
    "about": { "@id": "https://kombu.uk/#business" },
    "description": description,
    "inLanguage": "en-GB"
  }
];
---
<Layout title={title} description={description} extraSchema={extraSchema}>

<Nav current="home" />

<main id="main" class="home-page">


  <section class="home-opening" id="home-intro" data-holds-nav aria-label="Kombu creative studio">
    <div class="home-hero">
      <h1 class="wm home-wordmark" aria-label="Kombu">
        <span style="--i:0">K</span><span style="--i:1">O</span><span style="--i:2">M</span><span style="--i:3">B</span><span style="--i:4">U</span>
      </h1>
      <div class="home-introduction">
        <p><span>Websites, photography, design and marketing.</span> <span>One person who sees how it all fits.</span></p>
        <span>Independent creative studio<br />Southampton &amp; beyond</span>
      </div>
    </div>
    <div class="home-tray">
      {cells.map((c, i) => (
        <article class={`discipline discipline--${c.id}`}>
          <div class="discipline-copy">
            <h2>{c.id === 'mktg' ? <>Marketing<small>&amp; infrastructure</small></> : c.title}</h2>
            <p>{c.body}{c.bodyLink && <> <a class="discipline-link" href={c.bodyLink.href}>{c.bodyLink.text}</a>{c.bodyAfter}</>}</p>
          </div>
          <div class="discipline-art">
            <div class="example example--back"><Img src={c.back.img} sizes="(max-width: 767px) 66vw, 17vw" alt={c.back.alt} loading={i === 0 ? "eager" : "lazy"} decoding="async" /></div>
            <div class="example example--front"><Img src={c.front.img} sizes="(max-width: 767px) 66vw, 17vw" alt={c.front.alt} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} decoding={i === 0 ? undefined : "async"} /></div>
          </div>
          <div class="discipline-footer">
            <span class="discipline-fact">{c.fact}</span>
            <a href={c.href} class="pill" aria-label={`See the work: ${c.title.toLowerCase()}`}>See the work</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    // Desktop opening (see "Desktop opening" in home-preview.css). The hero
    // lags the scroll by LAG of its speed until it has used up the gap above
    // the tray; each compartment pops in once, in order and at least STEP ms
    // apart, when it rises past 88% of the screen; the line fades in over the
    // glide; the nav shows when the fourth is in. Phones, tablets, reduced
    // motion and ?nomotion never arm it.
    (function () {
      var root = document.getElementById('home-intro'), html = document.documentElement;
      if (!root || html.classList.contains('no-motion') || !matchMedia('(min-width: 1025px)').matches) return;
      var hero = root.querySelector('.home-hero'), sub = root.querySelector('.home-introduction');
      var cards = Array.prototype.slice.call(root.querySelectorAll('.home-tray .discipline'));
      var nav = document.querySelector('.nav');
      var LAG = 0.55, STEP = 170, GAP = 40;
      var lagMax = 0, glide = 1, done = 0, lastPop = 0, navShown = false, lastS = -1;
      root.classList.add('is-armed');
      function showNav() { if (!navShown && nav) { navShown = true; nav.classList.add('is-shown'); } }
      function measure() {
        root.style.setProperty('--lag', '0px');
        var subBottom = sub.getBoundingClientRect().bottom, trayTop = root.querySelector('.home-tray').getBoundingClientRect().top;
        lagMax = Math.max(0, trayTop - subBottom - GAP);
        glide = Math.max(1, lagMax / LAG);
      }
      function frame(now) {
        var s = scrollY;
        if (s !== lastS) {
        lastS = s;
        root.style.setProperty('--lag', Math.min(LAG * s, lagMax).toFixed(1) + 'px');
        var t = Math.min(1, s / (glide * 0.6));
        root.style.setProperty('--sub', (t * t * (3 - 2 * t)).toFixed(3));
        }
        if (done < cards.length && now - lastPop >= STEP && cards[done].getBoundingClientRect().top < innerHeight * 0.88) {
          cards[done].classList.add('is-in'); done++; lastPop = now;
          if (done === cards.length) setTimeout(showNav, 380);
        }
        if (s > glide + innerHeight) showNav();
        requestAnimationFrame(frame);
      }
      measure();
      addEventListener('resize', function () { measure(); lastS = -1; });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { measure(); lastS = -1; });
      requestAnimationFrame(frame);
    })();
  </script>

  <section class="connected bleed" aria-labelledby="connected-h">
    <div class="connected-grid">
      <div class="connected-copy">
        <h2 id="connected-h">One brand,<br />kept together</h2>
        <p>For Padharo, I handle the photography, menus, website, social and strategy. Every piece comes from the same person, so it all belongs together.</p>
        <p>From the first impression online to the menu on the table, the same care runs through it. One conversation, with the person doing the work.</p>
        <a href="/design/#cs-padharo" class="pill">Explore Padharo</a>
      </div>
      <div class="connected-proof">
        <figure class="proof-web">
          <a class="proof-surface" href="https://padharo.co.uk" target="_blank" rel="noopener"><Img src="/images/preview/padharo-hero.webp" sizes="(max-width: 767px) 92vw, 52vw" alt="Padharo restaurant website" loading="lazy" /></a>
          <figcaption>The website</figcaption>
        </figure>
        <figure class="proof-print">
          <a class="proof-surface" href="/design/#cs-padharo"><Img src="/images/design/padharo-menu-2026-front.jpg" sizes="(max-width: 767px) 40vw, 24vw" alt="The 2026 Padharo menu, with cream, navy and terracotta sections" loading="lazy" /></a>
          <figcaption>The menu</figcaption>
        </figure>
        <figure class="proof-print">
          <a class="proof-surface" href="/design/#cs-padharo"><Img src="/images/design/padharo-christmas-back.jpg" sizes="(max-width: 767px) 40vw, 24vw" alt="The Padharo Christmas campaign, a full feast photographed under gold script" loading="lazy" /></a>
          <figcaption>The campaign</figcaption>
        </figure>
      </div>
    </div>
    <div class="connected-note">
      <h3>Whatever the missing piece is, I build it</h3>
      <p>A menu, a website, or the practical thing nobody else has picked up. I work out what is needed, then make it happen.</p>
      <a href={WA} class="pill" target="_blank" rel="noopener">Tell me what you need</a>
    </div>
  </section>

  <section class="work bleed" aria-labelledby="work-h">
    <div class="sec-head work-head">
      <h2 id="work-h">Selected work</h2>
      <div class="work-actions">
        <button type="button" class="pill" data-work-previews-toggle aria-pressed="false">Pause previews</button>
        <a href="/work/" class="pill">Case studies</a>
        <a href="/web-design/restaurants/" class="pill">Restaurants &amp; pubs</a>
        <a href="/web-design/#work" class="pill">More websites</a>
      </div>
    </div>
    <div class="work-grid">
      {work.map((w) => (
        <article class={w.tabletOnly ? 'wcard wcard--tablet' : 'wcard'}>
          <a href={w.url} target="_blank" rel="noopener" class="project-browser" aria-label={`Open the ${w.name} website`}>
            <WorkPreview slug={w.slug} alt={w.alt} />
          </a>
          <div class="wcard-meta">
            <div>
              <h3>{w.name}</h3>
              <p>{w.line}</p>
              {w.cs && <a href={w.cs} class="wcard-case">Read the case study</a>}
            </div>
            <a href={w.url} target="_blank" rel="noopener" class="pill pill--sm" aria-label={`Visit the ${w.name} website`}>Visit</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="card-section bleed" aria-labelledby="about-h">
    <div class="card card--terracotta about">
      <div class="portrait" id="portrait">
        <div class="portrait-clip">
          <Img class="portrait-cut" src="/images/ryan-cutout.webp" alt="Ryan Stanikk" sizes="(max-width: 900px) 110vw, 45vw" />
        </div>
      </div>
      <div class="stack">
        <h2 id="about-h">Ryan Stanikk</h2>
        <p>I'm a Southampton designer, photographer and web developer running Kombu as a one-person studio. In Japanese cooking, kombu is the ingredient you never see, the quiet foundation that makes everything around it better. That is roughly the idea here: the base layer a business is built on, kept in one place instead of farmed out across a chain of agencies. Twenty years of graphic design, fifteen behind the camera, and a habit of building the thing rather than charging you to wait for it.</p>
        <a href="/about/" class="pill">More about me</a>
      </div>
    </div>
  </section>

  <Reviews />

  <Marquee />

  <ContactCard text="Tell me what you are trying to do and I will tell you, honestly, how I would do it, and whether I am even the right person for the job." />

</main>

<Footer />

<script is:inline src="/work-previews.js"></script>
</Layout>
