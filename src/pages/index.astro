---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import ContactCard from '../components/ContactCard.astro';

const title = "Kombu | Creative, Design & Marketing Studio in Southampton";
const description = "A one-person creative studio in Southampton: web design, graphic design, commercial photography and marketing that finally pull in the same direction.";

// Every fact below is lifted from the live site. Nothing new is claimed.
// Each cell shows two stacked examples of the work: front and back.
const cells = [
  { id: 'web', href: '/web-design', title: 'Websites', fact: 'From £49 a month', body: 'Bespoke, fast, design-led websites and web apps. No templates, no agency runaround.',
    front: { img: '/images/work/msnry-sm.webp', alt: 'The msnry app website, built by Kombu' },
    back: { img: '/images/work/the-grand-sm.webp', alt: 'The Grand Southampton website, designed by Kombu' } },
  { id: 'photo', href: '/photography', title: 'Photography', fact: '2 hours from £275', body: 'Food, interiors, product and brand photography that earns the booking.',
    front: { img: '/images/tray/photo-a.webp', alt: 'A spritz and a mojito on a terrace table, drinks photography by Kombu' },
    back: { img: '/images/tray/photo-b.webp', alt: 'Behind the scenes brand lifestyle photography on location by Kombu' } },
  { id: 'design', href: '/design', title: 'Graphic design', fact: '20 years of design', body: 'Brand identities, menus, print and editorial, with two decades behind the pen.',
    front: { img: '/images/tray/design-a.webp', alt: 'The Kwackers burger menu, designed by Kombu' },
    back: { img: '/images/tray/design-b.webp', alt: 'The Ideal Produce catalogue cover, designed by Kombu' } },
  { id: 'mktg', href: '/marketing', title: 'Marketing & infrastructure', fact: 'Health Check from £295', body: 'Strategy, ads, social and local SEO, plus the systems, sourcing and tools that tie a business together.',
    front: { img: '/images/tray/mktg-a.webp', alt: 'Padharo Veganuary offer graphic, designed by Kombu' },
    back: { img: '/images/tray/mktg-b.webp', alt: 'Padharo free starter promotion, designed by Kombu' } },
];

const work = [
  { name: 'Padharo', url: 'https://www.padharo.co.uk', poster: '/images/portfolio/padharo.jpg', alt: 'Padharo vegetarian Indian restaurant website with reservations and menus', line: 'Award-winning vegetarian Indian restaurant. Reservations, menus, and room for the photography to work.' },
  { name: 'Grumpy Monkey', url: 'https://www.grumpy-monkey.co.uk', poster: '/images/portfolio/grumpy-monkey.jpg', alt: 'Grumpy Monkey late night cocktail bar website in Southampton', line: 'A late night bar that trades on neon and noise. Weekly events, menus and table bookings, quick on a phone.' },
  { name: 'Ryan Stanikk Photography', url: 'https://ryanstanikk.co.uk', poster: '/images/portfolio/ryanstanikk.jpg', alt: 'Ryan Stanikk Photography portfolio website', line: 'My own photography portfolio. Food, interiors and portraits, with the galleries doing the talking.' },
];

const WA = 'https://wa.me/442381112819';

const extraSchema = [
  {
    "@type": "WebPage",
    "@id": "https://kombu.uk/#webpage",
    "url": "https://kombu.uk/",
    "name": title,
    "isPartOf": { "@id": "https://kombu.uk/#website" },
    "about": { "@id": "https://kombu.uk/#business" },
    "description": description,
    "inLanguage": "en-GB"
  }
];
---
<Layout title={title} description={description} extraSchema={extraSchema}>

<Nav current="home" />

<main id="main">

  <!-- The intro: the name alone, then the tray pops in under it. -->
  <section class="intro" id="intro" aria-label="Kombu">
    <div class="intro-stage">
      <h1 class="wm" id="wm" aria-label="Kombu">
        <span style="--i:0">K</span><span style="--i:1">O</span><span style="--i:2">M</span><span style="--i:3">B</span><span style="--i:4">U</span>
      </h1>
      <div class="tray-grid" id="tray">
        {cells.map((c, i) => (
          <a href={c.href} class={`cell cell--${c.id}`}>
            <div class="cell-head">
              <h2>{c.title}</h2>
              <p>{c.body}</p>
            </div>
            <div class="cell-imgs">
              <div class="cell-tile cell-tile--back"><img src={c.back.img} alt={c.back.alt} width="800" height="880" loading="lazy" decoding="async" /></div>
              <div class="cell-tile cell-tile--front"><img src={c.front.img} alt={c.front.alt} width="800" height="880" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" /></div>
            </div>
            <div class="cell-foot">
              <span class="chip">{c.fact}</span>
              <span class="pill pill--sm">See the work</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The one crafted line on the page. -->
  <section class="card-section bleed" aria-labelledby="piece-h">
    <div class="card card--kelp two">
      <h2 id="piece-h">Whatever the missing piece is, I build it</h2>
      <div class="stack">
        <p>I am a designer and photographer by trade, but the thing clients keep me around for is broader than that: an engineering mind paired with a designer's eye. When something in your setup is broken, slow or simply does not exist yet, I work out how to fix it and then go and do it, rather than handing you off to a specialist who charges a fortune and does not know your brand.</p>
        <a href={WA} class="pill pill--fill" target="_blank" rel="noopener">Tell me what's broken</a>
      </div>
    </div>
  </section>

  <section class="work bleed" aria-labelledby="work-h">
    <div class="sec-head work-head">
      <h2 id="work-h">Selected work</h2>
      <a href="/web-design#work" class="pill">All six sites</a>
    </div>
    <div class="work-grid">
      {work.map((w) => (
        <article class="wcard">
          <a href={w.url} target="_blank" rel="noopener" class="project-browser" aria-label={`Open the ${w.name} website`}>
            <div class="browser-viewport" data-site={w.url}>
              <div class="browser-stack"><img src={w.poster} alt={w.alt} loading="lazy" class="browser-poster" /></div>
            </div>
          </a>
          <div class="wcard-meta">
            <div>
              <h3>{w.name}</h3>
              <p>{w.line}</p>
            </div>
            <a href={w.url} target="_blank" rel="noopener" class="pill pill--sm" aria-label={`Visit the ${w.name} website`}>Visit</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="card-section bleed" aria-labelledby="about-h">
    <div class="card card--terracotta about">
      <div class="portrait" id="portrait">
        <div class="portrait-clip">
          <img class="portrait-cut" src="/images/ryan-cutout.webp" alt="Ryan Stanikk" width="1100" height="1024" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="stack">
        <h2 id="about-h">Ryan Stanikk</h2>
        <p>I'm a Southampton designer, photographer and web developer running Kombu as a one-person studio. In Japanese cooking, kombu is the ingredient you never see, the quiet foundation that makes everything around it better. That is roughly the idea here: the base layer a business is built on, kept in one place instead of farmed out across a chain of agencies. Twenty years of graphic design, fifteen behind the camera, and a habit of building the thing rather than charging you to wait for it.</p>
        <a href="/about" class="pill">More about me</a>
      </div>
    </div>
  </section>

  <Marquee />

  <ContactCard text="Tell me what you are trying to do and I will tell you, honestly, how I would do it, and whether I am even the right person for the job." />

</main>

<Footer />

</Layout>
